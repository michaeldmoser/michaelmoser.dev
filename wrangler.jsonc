{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "michaelmoser-dev",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "michaelmoser.dev", "custom_domain": true }],
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build"
  }
}
