{
  "name": "michaelmoser.dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "build": "node --import tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts --input=src && node --import tsx scripts/check-site.ts _site",
    "dev": "node --import tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts --input=src --serve --output=.dev-site",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@11ty/eleventy": "~3.1.8",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@biomejs/biome": "2.6.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "fast-xml-parser": "^5.12.0",
    "html-validate": "^11.21.0",
    "jsx-async-runtime": "^3.0.0",
    "postcss": "8.5.32",
    "satori": "^0.63.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
